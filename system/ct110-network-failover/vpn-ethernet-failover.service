[Unit]
Description=CT110 probe-governed VPN to home ethernet internet failover
Documentation=file:/usr/local/share/doc/ct110-network-failover/README.md
Wants=network-online.target
After=systemd-networkd.service network-online.target

[Service]
Type=simple
ExecStart=/usr/local/libexec/vpn-ethernet-failover
Restart=always
RestartSec=5s
StateDirectory=vpn-ethernet-failover
RuntimeDirectory=vpn-ethernet-failover

# The service needs only enough privilege to inspect and adjust routes.
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/vpn-ethernet-failover
RestrictAddressFamilies=AF_INET AF_NETLINK AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service @network-io
LockPersonality=yes
MemoryDenyWriteExecute=yes
UMask=0077

[Install]
WantedBy=multi-user.target
