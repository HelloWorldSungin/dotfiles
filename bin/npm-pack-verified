#!/usr/bin/env bash
set -euo pipefail

[ "$#" -eq 5 ] || { printf 'npm-pack-verified: expected npm, package, version, integrity, and destination\n' >&2; exit 2; }
npm_bin=$1
package=$2
version=$3
expected=$4
destination=$5
printf '%s\n' "$expected" | grep -Eq '^sha512-[A-Za-z0-9+/]+={0,2}$' || exit 1
[ -d "$destination" ] || exit 1

packed=$("$npm_bin" pack "$package@$version" --json --pack-destination "$destination")
filename=$(printf '%s' "$packed" | jq -er --arg name "$package" --arg version "$version" \
  'if type == "array" and length == 1 and .[0].name == $name and .[0].version == $version then .[0].filename | strings else empty end')
printf '%s\n' "$filename" | grep -Eq '^[A-Za-z0-9._-]+\.tgz$' || exit 1
archive="$destination/$filename"
[ -f "$archive" ] || exit 1
actual=$(node -e '
  const fs = require("node:fs");
  const crypto = require("node:crypto");
  const hash = crypto.createHash("sha512");
  fs.createReadStream(process.argv[1])
    .on("data", chunk => hash.update(chunk))
    .on("end", () => process.stdout.write("sha512-" + hash.digest("base64")))
    .on("error", () => process.exit(1));
' "$archive")
[ "$actual" = "$expected" ] || exit 1
printf '%s\n' "$archive"
