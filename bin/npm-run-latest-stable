#!/usr/bin/env bash
set -euo pipefail

NPM_BIN=${DEV_TOOLS_NPM_BIN:-npm}
NPX_BIN=${DEV_TOOLS_NPX_BIN:-npx}

[ "$#" -ge 1 ] || { printf 'npm-run-latest-stable: package required\n' >&2; exit 2; }
package=$1
shift
case "$package" in opencode-ai|omp-acp|claude-spend) ;; *) printf 'npm-run-latest-stable: unsupported package: %s\n' "$package" >&2; exit 2 ;; esac

latest=$($NPM_BIN view "$package@latest" version dist.integrity --json)
version=$(printf '%s' "$latest" | jq -er '.version | strings')
integrity=$(printf '%s' "$latest" | jq -er '."dist.integrity" // .dist.integrity | strings')
printf '%s\n' "$version" | grep -Eq '^[0-9]+(\.[0-9]+){2,3}$' || { printf 'npm-run-latest-stable: unstable version\n' >&2; exit 1; }
printf '%s\n' "$integrity" | grep -Eq '^sha512-[A-Za-z0-9+/]+={0,2}$' || { printf 'npm-run-latest-stable: publisher integrity missing\n' >&2; exit 1; }

exact=$($NPM_BIN view "$package@$version" version dist.integrity --json)
exact_version=$(printf '%s' "$exact" | jq -er '.version | strings')
exact_integrity=$(printf '%s' "$exact" | jq -er '."dist.integrity" // .dist.integrity | strings')
[ "$exact_version" = "$version" ] && [ "$exact_integrity" = "$integrity" ] || {
  printf 'npm-run-latest-stable: resolved artifact changed\n' >&2
  exit 1
}

tmp=$(mktemp -d "${TMPDIR:-/tmp}/npm-latest-stable.XXXXXX")
trap 'rm -rf "$tmp"' EXIT
packed=$($NPM_BIN pack "$package@$version" --json --pack-destination "$tmp")
packed_name=$(printf '%s' "$packed" | jq -er 'if type == "array" and length == 1 then .[0].name | strings else empty end')
packed_version=$(printf '%s' "$packed" | jq -er 'if type == "array" and length == 1 then .[0].version | strings else empty end')
packed_filename=$(printf '%s' "$packed" | jq -er 'if type == "array" and length == 1 then .[0].filename | strings else empty end')
[ "$packed_name" = "$package" ] && [ "$packed_version" = "$version" ] && [ "$packed_filename" = "$package-$version.tgz" ] || {
  printf 'npm-run-latest-stable: packed artifact identity changed\n' >&2
  exit 1
}
archive="$tmp/$packed_filename"
[ -f "$archive" ] || { printf 'npm-run-latest-stable: packed artifact missing\n' >&2; exit 1; }
actual=$(node -e '
  const fs = require("node:fs");
  const crypto = require("node:crypto");
  const hash = crypto.createHash("sha512");
  fs.createReadStream(process.argv[1])
    .on("data", chunk => hash.update(chunk))
    .on("end", () => process.stdout.write("sha512-" + hash.digest("base64")))
    .on("error", () => process.exit(1));
' "$archive")
[ "$actual" = "$integrity" ] || { printf 'npm-run-latest-stable: packed artifact integrity changed\n' >&2; exit 1; }

"$NPX_BIN" -y "$archive" "$@"
