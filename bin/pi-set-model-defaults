#!/usr/bin/env bash
# Own the Pi model defaults without taking over any machine-maintained file:
#
#   1. ~/.pi/agent/settings.json - Pi writes this itself (lastChangelogVersion,
#      theme, /model and /thinking Ctrl+S saves, /settings), so exactly three
#      keys are merged atomically: defaultProvider, defaultModel,
#      defaultThinkingLevel. Every other key is preserved.
#   2. The Firstmate Pi supervision-branch pins, config/supervision-branch-model
#      and config/supervision-branch-effort under the Firstmate home. Those are
#      the files Firstmate's own /supervision-model command writes; the format
#      (one `<provider>/<model-id>` or one thinking level, then a newline, mode
#      0600, atomic replace) mirrors that command. Skipped when the Firstmate
#      home has no config/ directory, so a host without Firstmate is untouched.
#
# Idempotent: a file whose content already matches is never rewritten.
set -euo pipefail

PROVIDER="${PI_DEFAULT_PROVIDER:-openai-codex}"
MODEL="${PI_DEFAULT_MODEL:-gpt-6-astra}"
THINKING="${PI_DEFAULT_THINKING_LEVEL:-low}"
SUPERVISION_MODEL="${PI_SUPERVISION_MODEL:-openai-codex/gpt-5.6-luna}"
SUPERVISION_EFFORT="${PI_SUPERVISION_EFFORT:-high}"
SETTINGS="${PI_SETTINGS_FILE:-${PI_CODING_AGENT_DIR:-${HOME}/.pi/agent}/settings.json}"
FIRSTMATE_HOME="${PI_SUPERVISION_FIRSTMATE_HOME:-${HOME}/firstmate}"

valid_level() {
  case "$1" in off|minimal|low|medium|high|xhigh|max) return 0 ;; esac
  return 1
}
valid_level "$THINKING" || { echo "invalid thinking level: $THINKING" >&2; exit 2; }
valid_level "$SUPERVISION_EFFORT" || { echo "invalid supervision effort: $SUPERVISION_EFFORT" >&2; exit 2; }
case "$SUPERVISION_MODEL" in
  */?*) ;;
  *) echo "supervision model must be <provider>/<model-id>: $SUPERVISION_MODEL" >&2; exit 2 ;;
esac

# replace_if_changed <target> <mode-or-empty> ; new content on stdin
replace_if_changed() {
  local target=$1 mode=$2 tmp
  tmp=$(mktemp "${target}.XXXXXX")
  cat > "$tmp"
  if [ -f "$target" ] && cmp -s "$tmp" "$target"; then
    rm -f "$tmp"
    return 0
  fi
  if [ -n "$mode" ]; then
    chmod "$mode" "$tmp"
  else
    chmod --reference="$target" "$tmp" 2>/dev/null || chmod 0644 "$tmp"
  fi
  mv -f "$tmp" "$target"
}

mkdir -p "$(dirname "$SETTINGS")"
if [ -s "$SETTINGS" ]; then
  current=$(cat "$SETTINGS")
else
  current='{}'
fi
new=$(printf '%s' "$current" | jq --indent 2 \
  --arg provider "$PROVIDER" --arg model "$MODEL" --arg thinking "$THINKING" \
  '.defaultProvider = $provider | .defaultModel = $model | .defaultThinkingLevel = $thinking') \
  || { echo "refusing to merge: $SETTINGS is not valid JSON" >&2; exit 1; }
printf '%s\n' "$new" | replace_if_changed "$SETTINGS" ""

if [ -d "$FIRSTMATE_HOME/config" ]; then
  printf '%s\n' "$SUPERVISION_MODEL" | replace_if_changed "$FIRSTMATE_HOME/config/supervision-branch-model" 0600
  printf '%s\n' "$SUPERVISION_EFFORT" | replace_if_changed "$FIRSTMATE_HOME/config/supervision-branch-effort" 0600
fi
