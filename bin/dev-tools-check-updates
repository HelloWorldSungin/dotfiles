#!/usr/bin/env bash
# dev-tools-check-updates - read-only installed/pinned/latest toolchain audit.
#
# Network and version commands are bounded. This command never installs,
# updates, reloads, restarts, or runs setup hooks. Normal checks write only a
# bounded cache; --no-cache leaves no persistent files behind. Git sources use
# ls-remote rather than fetch.
#
# Usage: dev-tools-check-updates [--json] [--force] [--no-cache] [--startup]
#                                [--health]
set -u

SELF_DIR=$(cd "$(dirname "$0")" && pwd)
ROOT=$(cd "$SELF_DIR/.." && pwd)
PINS_FILE=${DEV_TOOLS_PINS_FILE:-$ROOT/config/dev-tools-versions.sh}
FLAKE_LOCK_FILE=${DEV_TOOLS_FLAKE_LOCK_FILE:-$ROOT/flake.lock}
# Generated by home/dev-tools.nix from the one closure-input attrset the wrappers
# select from: name -> the exact store path Home Manager materialized. Present
# only in the packaged wrappers; a repository-local run has no closure to audit.
CLOSURE_FILE=${DEV_TOOLS_CLOSURE_FILE:-}
CLOSURE_VERSION=
CLOSURE_REASON=
CACHE_HOME=${XDG_CACHE_HOME:-${HOME:-.}/.cache}
CACHE_PATH=${DEV_TOOLS_UPDATE_CACHE_PATH:-$CACHE_HOME/dev-tools-update-checker/cache.json}
CACHE_TTL=${DEV_TOOLS_UPDATE_CACHE_TTL_SECONDS:-14400}
NETWORK_TIMEOUT=${DEV_TOOLS_UPDATE_NETWORK_TIMEOUT_SECONDS:-15}
NPM_BIN=${DEV_TOOLS_UPDATE_NPM_BIN:-npm}
CURL_BIN=${DEV_TOOLS_UPDATE_CURL_BIN:-curl}
GIT_BIN=${DEV_TOOLS_UPDATE_GIT_BIN:-git}
SHA256_BIN=${DEV_TOOLS_UPDATE_SHA256_BIN:-$(command -v sha256sum >/dev/null 2>&1 && printf sha256sum || printf 'shasum -a 256')}
PRINTENV_BIN=${DEV_TOOLS_HEALTH_PRINTENV_BIN:-printenv}
BIN_DIR=${DEV_TOOLS_UPDATE_BIN_DIR:-}
FIRSTMATE_PATH=${DEV_TOOLS_FIRSTMATE_PATH:-${HOME:-.}/firstmate}
BABY_MENU_PATH=${DEV_TOOLS_BABY_MENU_PATH:-${HOME:-.}/baby-menu}
NVIM_DATA_HOME=${DEV_TOOLS_NVIM_DATA_HOME:-${XDG_DATA_HOME:-${HOME:-.}/.local/share}/nvim}
MODE=human
FORCE=0
NO_CACHE=0
STARTUP=0
HEALTH=0

usage() { sed -n '/^# dev-tools-check-updates - /,/^set -u$/s/^# \{0,1\}//p' "$0"; }
while [ "$#" -gt 0 ]; do
  case "$1" in
    --json) MODE=json ;;
    --force) FORCE=1 ;;
    --no-cache) NO_CACHE=1 ;;
    --startup) STARTUP=1 ;;
    --health) HEALTH=1 ;;
    --help|-h) usage; exit 0 ;;
    *) printf 'dev-tools-check-updates: unknown argument: %s\n' "$1" >&2; exit 2 ;;
  esac
  shift
done

[ -f "$PINS_FILE" ] || { printf 'dev-tools-check-updates: pins unavailable: %s\n' "$PINS_FILE" >&2; exit 2; }
# shellcheck source=../config/dev-tools-versions.sh
# shellcheck disable=SC1091
source "$PINS_FILE"
case "$CACHE_TTL" in ''|*[!0-9]*|0) CACHE_TTL=14400 ;; esac
case "$NETWORK_TIMEOUT" in ''|*[!0-9]*|0) NETWORK_TIMEOUT=15 ;; esac
NOW=${DEV_TOOLS_UPDATE_NOW_EPOCH:-$(date +%s)}
case "$NOW" in ''|*[!0-9]*) NOW=$(date +%s) ;; esac

run_timed() {
  local seconds=$1
  shift
  if command -v timeout >/dev/null 2>&1; then timeout "$seconds" "$@"
  elif command -v gtimeout >/dev/null 2>&1; then gtimeout "$seconds" "$@"
  else "$@"
  fi
}

command_path() {
  if [ -n "$BIN_DIR" ] && [ -x "$BIN_DIR/$1" ]; then printf '%s\n' "$BIN_DIR/$1"
  else command -v "$1" 2>/dev/null
  fi
}

normalize_version() {
  printf '%s\n' "$1" | grep -Eo '[0-9]+(\.[0-9]+){1,3}(-[0-9A-Za-z]+)?' | head -1
}

stable_version() {
  local version=${1#v}
  printf '%s\n' "$version" | grep -Eq '^[0-9]+(\.[0-9]+){2,3}$'
}

# A `closure` package reaches the operator only through a wrapper's own PATH, so
# it is measured from the store path that wrapper carries. `command -v` would
# report whatever the ambient PATH holds - an unrelated system build, or none at
# all - and label the pinned closure as drifted, so the closure path never falls
# back to it: every way the generated manifest can fail to bind the package is
# reported as unknown, with the reason in the detail.
closure_store_path() {
  [ -n "$CLOSURE_FILE" ] && [ -r "$CLOSURE_FILE" ] || return 1
  jq -e -r --arg n "$1" '.[] | select(.name == $n) | .store_path' "$CLOSURE_FILE" 2>/dev/null | head -1
}

# Sets CLOSURE_VERSION and CLOSURE_REASON; the version is `unknown` when the
# manifest cannot bind this package to a runnable executable.
closure_measure() {
  local package=$1 command_name=$2 store_path output
  CLOSURE_VERSION=unknown
  if [ -z "$CLOSURE_FILE" ]; then
    CLOSURE_REASON='no closure measurement manifest is bound, so the wrapper closure cannot be measured'
    return
  fi
  if [ ! -r "$CLOSURE_FILE" ]; then
    CLOSURE_REASON='the closure measurement manifest is unreadable'
    return
  fi
  if ! jq -e 'type == "array"' "$CLOSURE_FILE" >/dev/null 2>&1; then
    CLOSURE_REASON='the closure measurement manifest is malformed'
    return
  fi
  store_path=$(closure_store_path "$package" || true)
  if [ -z "$store_path" ]; then
    CLOSURE_REASON='the closure measurement manifest does not bind this package'
    return
  fi
  if [ ! -x "$store_path/bin/$command_name" ]; then
    CLOSURE_REASON="the bound closure path does not carry an executable $command_name"
    return
  fi
  output=$(run_timed "$NETWORK_TIMEOUT" env NO_UPDATE_NOTIFIER=1 "$store_path/bin/$command_name" --version 2>&1) || {
    CLOSURE_REASON='the bound closure executable did not report a version'
    return
  }
  CLOSURE_VERSION=$(normalize_version "$output")
  if [ -z "$CLOSURE_VERSION" ]; then
    CLOSURE_VERSION=unknown
    CLOSURE_REASON='the bound closure executable reported no recognisable version'
    return
  fi
  CLOSURE_REASON='measured from the exact wrapper closure store path, never the ambient PATH'
}

installed_command_version() {
  local path output version
  path=$(command_path "$1") || return 1
  output=$(run_timed "$NETWORK_TIMEOUT" env NO_UPDATE_NOTIFIER=1 "$path" --version 2>&1) || return 2
  version=$(normalize_version "$output")
  [ -n "$version" ] || return 2
  printf '%s\n' "$version"
}

classify() {
  local current=$1 pinned=$2 latest=$3
  if [ "$latest" = unknown ] || [ "$current" = unknown ]; then printf unknown
  elif [ "$current" = on-demand ]; then
    [ "$pinned" = "$latest" ] && printf up_to_date || printf pin_outdated
  elif [ "$pinned" != "$latest" ] && [ "$current" != "$pinned" ]; then printf pin_outdated_and_drifted
  elif [ "$pinned" != "$latest" ]; then printf pin_outdated
  elif [ "$current" != "$pinned" ]; then printf drifted
  else printf up_to_date
  fi
}

tool_json() {
  local name=$1 source=$2 current=$3 pinned=$4 latest=$5 install_policy=$6 apply_policy=$7 detail=${8:-} status
  status=$(classify "$current" "$pinned" "$latest")
  jq -cn --arg name "$name" --arg source "$source" --arg current "$current" \
    --arg pinned "$pinned" --arg latest "$latest" --arg status "$status" \
    --arg install_policy "$install_policy" --arg apply_policy "$apply_policy" --arg detail "$detail" \
    '{name:$name,source:$source,current:$current,pinned:$pinned,latest_stable:$latest,status:$status,install_policy:$install_policy,apply_policy:$apply_policy}
     + (if $detail == "" then {} else {detail:$detail} end)'
}

latest_npm() {
  local package=$1 channel=${2:-default} output version
  if [ "$channel" = stable ]; then
    output=$(run_timed "$NETWORK_TIMEOUT" "$NPM_BIN" view "$package" dist-tags.stable --json 2>/dev/null) || return 1
  elif [ "$channel" = default ]; then
    output=$(run_timed "$NETWORK_TIMEOUT" "$NPM_BIN" view "$package" version --json 2>/dev/null) || return 1
  else
    return 3
  fi
  version=$(printf '%s' "$output" | jq -er 'if type == "string" then . else empty end' 2>/dev/null) || return 1
  stable_version "$version" || return 2
  printf '%s\n' "$version"
}

check_npm_tool() {
  local name=$1 command_name=$2 package=$3 pinned=$4 _integrity=$5 guarded=$6 channel=$7 current latest policy detail='' rc source
  current=$(installed_command_version "$command_name" || printf unknown)
  latest=$(latest_npm "$package" "$channel"); rc=$?
  case "$rc" in
    0) : ;;
    2) latest=unknown; detail="npm $channel channel resolved to a prerelease" ;;
    3) latest=unknown; detail='unknown npm stable channel refused' ;;
    *) latest=unknown; detail='npm registry lookup failed' ;;
  esac
  [ "$guarded" = yes ] && policy='guarded-exact' || policy='report-only'
  [ "$channel" = stable ] && source=npm-stable-dist-tag || source=npm-default-dist-tag
  tool_json "$name" "$source" "$current" "$pinned" "$latest" exact-npm "$policy" "$detail"
}

latest_github_tag() {
  local repo=$1 json tag
  json=$(run_timed "$NETWORK_TIMEOUT" "$CURL_BIN" -fsSL --connect-timeout 5 --max-time "$NETWORK_TIMEOUT" \
    -H 'Accept: application/vnd.github+json' "https://api.github.com/repos/$repo/releases/latest" 2>/dev/null) || return 1
  tag=$(printf '%s' "$json" | jq -er 'select(.draft == false and .prerelease == false) | .tag_name | select(type == "string")' 2>/dev/null) || return 1
  stable_version "$tag" || return 2
  printf '%s\n' "$tag"
}

latest_github_tag_unrestricted() {
  local repo=$1 json
  json=$(run_timed "$NETWORK_TIMEOUT" "$CURL_BIN" -fsSL --connect-timeout 5 --max-time "$NETWORK_TIMEOUT" \
    -H 'Accept: application/vnd.github+json' "https://api.github.com/repos/$repo/releases/latest" 2>/dev/null) || return 1
  printf '%s' "$json" | jq -er 'select(.draft == false and .prerelease == false) | .tag_name | select(type == "string")' 2>/dev/null
}

check_github_tool() {
  local name=$1 command_name=$2 repo=$3 pinned=$4 install_policy=$5 apply_policy=$6 current latest detail='' rc
  current=$(installed_command_version "$command_name" || printf unknown)
  latest=$(latest_github_tag "$repo"); rc=$?
  case "$rc" in
    0) latest=${latest#v} ;;
    2) latest=unknown; detail='GitHub latest release has a prerelease-like tag' ;;
    *) latest=unknown; detail='latest non-draft, non-prerelease GitHub release could not be verified' ;;
  esac
  tool_json "$name" github-latest-release "$current" "$pinned" "$latest" "$install_policy" "$apply_policy" "$detail"
}

check_herdr() {
  local current json latest detail='' target latest_url expected_sha manifest_url manifest_sha row key _tree_sha _nm_sha herdr_sha
  current=$(installed_command_version herdr || printf unknown)
  json=$(run_timed "$NETWORK_TIMEOUT" "$CURL_BIN" -fsSL --connect-timeout 5 --max-time "$NETWORK_TIMEOUT" "$HERDR_LATEST_MANIFEST_URL" 2>/dev/null || true)
  latest=$(printf '%s' "$json" | jq -er '.version | select(type == "string")' 2>/dev/null || true)
  case "$PLATFORM" in linux-amd64) target=linux-x86_64 ;; linux-arm64) target=linux-aarch64 ;; darwin-amd64) target=macos-x86_64 ;; darwin-arm64) target=macos-aarch64 ;; *) target=unsupported ;; esac
  expected_sha=
  for row in "${RELEASE_SHA256_PINS[@]}"; do
    IFS='|' read -r key _tree_sha _nm_sha herdr_sha <<<"$row"
    [ "$key" = "$PLATFORM" ] && expected_sha=$herdr_sha
  done
  latest_url="https://github.com/herdrdev/herdr/releases/download/v${latest}/herdr-${target}"
  manifest_url=$(printf '%s' "$json" | jq -r --arg target "$target" '.assets[$target] // ""' 2>/dev/null || true)
  manifest_sha=$(printf '%s' "$json" | jq -r --arg target "$target" '.sha256[$target] // ""' 2>/dev/null || true)
  if ! stable_version "$latest"; then latest=unknown; detail='Herdr stable manifest did not expose a stable numeric version'
  elif [ -z "$expected_sha" ] || [ "$manifest_url" != "$latest_url" ] ||
       ! printf '%s\n' "$manifest_sha" | grep -Eq '^[0-9a-f]{64}$'; then
    latest=unknown; detail='Herdr stable manifest asset or checksum is invalid for this platform'
  elif [ "$latest" = "$HERDR_VERSION" ] && [ "$manifest_sha" != "$expected_sha" ]; then
    latest=unknown; detail='Herdr stable manifest checksum differs from the recorded pin'
  elif [ "$latest" != "$HERDR_VERSION" ]; then
    detail='publisher stable manifest is newer than the recorded attended-only pin'
  fi
  tool_json herdr herdr-stable-manifest "$current" "$HERDR_VERSION" "$latest" exact-manifest-binary attended-only "$detail"
}

check_antigravity() {
  local current latest json url detail='' key asset_suffix row pin_key expected_url expected_sha manifest_url manifest_sha
  current=$(installed_command_version agy || printf unknown)
  case "$PLATFORM" in
    linux-amd64) key=linux_amd64; asset_suffix=/linux-x64/cli_linux_x64.tar.gz ;;
    linux-arm64) key=linux_arm64; asset_suffix=/linux-arm/cli_linux_arm64.tar.gz ;;
    darwin-amd64) key=darwin_amd64; asset_suffix=/darwin-x64/cli_mac_x64.tar.gz ;;
    darwin-arm64) key=darwin_arm64; asset_suffix=/darwin-arm/cli_mac_arm64.tar.gz ;;
    *) key=unsupported; asset_suffix=unsupported ;;
  esac
  url="https://antigravity-cli-auto-updater-974169037036.us-central1.run.app/manifests/$key.json"
  json=$(run_timed "$NETWORK_TIMEOUT" "$CURL_BIN" -fsSL --connect-timeout 5 --max-time "$NETWORK_TIMEOUT" "$url" 2>/dev/null || true)
  latest=$(printf '%s' "$json" | jq -er '.version | select(type == "string")' 2>/dev/null || true)
  expected_url=''; expected_sha=''
  for row in "${ANTIGRAVITY_ASSET_PINS[@]}"; do
    IFS='|' read -r pin_key expected_url expected_sha <<<"$row"
    [ "$pin_key" = "$PLATFORM" ] && break
    expected_url=''; expected_sha=''
  done
  manifest_url=$(printf '%s' "$json" | jq -r '.url // ""' 2>/dev/null || true)
  manifest_sha=$(printf '%s' "$json" | jq -r '.sha512 // ""' 2>/dev/null || true)
  if ! stable_version "$latest"; then latest=unknown; detail='publisher production manifest did not expose a stable version'
  elif [ -z "$expected_url" ] ||
       ! printf '%s\n' "$manifest_sha" | grep -Eq '^[0-9a-f]{128}$'; then
    latest=unknown; detail='publisher production manifest asset or checksum is invalid for this platform'
  else
    case "$manifest_url" in
      "https://storage.googleapis.com/antigravity-public/antigravity-cli/${latest}-"*"$asset_suffix") ;;
      *) latest=unknown; detail='publisher production manifest asset is invalid for this platform' ;;
    esac
    if [ "$latest" != unknown ] && [ "$latest" = "$ANTIGRAVITY_VERSION" ] &&
       { [ "$manifest_url" != "$expected_url" ] || [ "$manifest_sha" != "$expected_sha" ]; }; then
      latest=unknown; detail='publisher production manifest asset or checksum differs from the recorded pin'
    elif [ "$latest" != unknown ] && [ "$latest" != "$ANTIGRAVITY_VERSION" ]; then
      detail='publisher production manifest is newer than the recorded pin'
    fi
  fi
  tool_json antigravity google-production-manifest "$current" "$ANTIGRAVITY_VERSION" "$latest" exact-manifest-asset report-only "$detail"
}

check_cursor() {
  local current tmp latest hash status detail
  current=$(installed_command_version cursor-agent || printf unknown)
  tmp=$(mktemp "${TMPDIR:-/tmp}/cursor-installer-check.XXXXXX") || {
    tool_json cursor-agent cursor-moving-beta "$current" "$CURSOR_AGENT_OBSERVED_VERSION" unknown unavailable-unpinnable report-only 'temporary audit file could not be created'
    return
  }
  if run_timed "$NETWORK_TIMEOUT" "$CURL_BIN" -fsSL --connect-timeout 5 --max-time "$NETWORK_TIMEOUT" "$CURSOR_INSTALLER_URL" -o "$tmp" 2>/dev/null; then
    latest=$(sed -n 's|.*versions/\([^/"[:space:]]*\)/cursor-agent.*|\1|p' "$tmp" | head -1)
    hash=$($SHA256_BIN "$tmp" 2>/dev/null | awk '{print $1}')
  else
    latest=unknown
    hash=unknown
  fi
  rm -f "$tmp"
  if [ "$latest" = unknown ] || [ -z "$latest" ]; then status=unknown; latest=unknown; detail='moving beta installer could not be audited'
  elif [ "$hash" != "$CURSOR_INSTALLER_SHA256" ]; then status=drifted; detail='moving beta installer hash changed; refresh or refuse the recorded snapshot'
  elif [ "$current" = unknown ]; then status=unknown; detail='not installed; upstream provides no stable or exact-version channel'
  elif [ "$current" != "$CURSOR_AGENT_OBSERVED_VERSION" ] || [ "$latest" != "$CURSOR_AGENT_OBSERVED_VERSION" ]; then status=drifted; detail='installed or advertised beta differs from the recorded snapshot'
  else status=up_to_date; detail='intentional beta exception; snapshot matches but no upstream stable channel exists'
  fi
  jq -cn --arg current "$current" --arg snapshot "$CURSOR_AGENT_OBSERVED_VERSION" --arg observed "$latest" --arg status "$status" --arg detail "$detail" \
    '{name:"cursor-agent",source:"cursor-moving-beta",current:$current,pinned:$snapshot,latest_stable:"unavailable",latest_observed:$observed,status:$status,install_policy:"unavailable-unpinnable",apply_policy:"report-only",detail:$detail}'
}

check_git_repo() {
  local name=$1 path=$2 repo=$3 pinned=$4 install_policy=$5 apply_policy=$6 current latest detail=
  if [ -d "$path/.git" ]; then current=$($GIT_BIN -C "$path" rev-parse HEAD 2>/dev/null || printf unknown); else current=unknown; fi
  latest=$(run_timed "$NETWORK_TIMEOUT" "$GIT_BIN" ls-remote "$repo" HEAD 2>/dev/null | awk '$2 == "HEAD" {print $1; exit}')
  if [ -z "$latest" ]; then latest=unknown; detail='remote HEAD could not be verified'; fi
  tool_json "$name" git-default-branch "$current" "$pinned" "$latest" "$install_policy" "$apply_policy" "$detail"
}

check_baby_menu() {
  local current json tag latest detail=
  if [ -d "$BABY_MENU_PATH/.git" ]; then current=$($GIT_BIN -C "$BABY_MENU_PATH" rev-parse HEAD 2>/dev/null || printf unknown); else current=unknown; fi
  json=$(run_timed "$NETWORK_TIMEOUT" "$CURL_BIN" -fsSL --connect-timeout 5 --max-time "$NETWORK_TIMEOUT" \
    -H 'Accept: application/vnd.github+json' 'https://api.github.com/repos/kunchenguid/baby-menu/releases/latest' 2>/dev/null || true)
  tag=$(printf '%s' "$json" | jq -er 'select(.draft == false and .prerelease == false) | .tag_name | select(test("^baby-menu-v[0-9]+(\\.[0-9]+){2,3}$"))' 2>/dev/null || true)
  if [ -n "$tag" ]; then latest=$(resolve_tag_commit kunchenguid/baby-menu "$tag"); detail="latest stable release $tag"
  else latest=unknown; detail='latest stable Baby Menu release could not be verified'
  fi
  [ -n "$latest" ] || latest=unknown
  tool_json baby-menu github-latest-release "$current" "$BABY_MENU_REV" "$latest" exact-release-commit report-only "$detail"
}

check_nix_installer() {
  local path output current latest detail='' rc
  path=$(command_path nix || true)
  if [ -n "$path" ]; then
    output=$(run_timed "$NETWORK_TIMEOUT" "$path" --version 2>/dev/null || true)
    current=$(printf '%s\n' "$output" | sed -n 's/.*Determinate Nix \([0-9][0-9.]*\).*/\1/p' | head -1)
    [ -n "$current" ] || current=unknown
  else current=unknown
  fi
  latest=$(latest_github_tag DeterminateSystems/nix-installer); rc=$?
  case "$rc" in 0) latest=${latest#v} ;; 2) latest=unknown; detail='latest installer tag is prerelease-like' ;; *) latest=unknown; detail='latest stable installer release could not be verified' ;; esac
  tool_json nix-installer github-latest-release "$current" "$NIX_INSTALLER_VERSION" "$latest" exact-versioned-installer report-only "$detail"
}

check_npx_tool() {
  local name=$1 package=$2 pinned=$3 latest detail='' rc
  latest=$(latest_npm "$package" default); rc=$?
  case "$rc" in 0) : ;; 2) latest=unknown; detail='npm default tag resolved to a prerelease' ;; *) latest=unknown; detail='npm registry lookup failed' ;; esac
  tool_json "$name" npm-default-dist-tag on-demand "$pinned" "$latest" exact-npx report-only "$detail"
}

check_nix_input() {
  local name=$1 repo=$2 ref=$3 pinned=$4 lock_node=$5 current latest detail=
  current=$(jq -er --arg node "$lock_node" '.nodes[$node].locked.rev | select(type == "string")' "$FLAKE_LOCK_FILE" 2>/dev/null || printf unknown)
  latest=$(run_timed "$NETWORK_TIMEOUT" "$GIT_BIN" ls-remote "$repo" "$ref" 2>/dev/null | awk -v r="$ref" '$2 == r {print $1; exit}')
  if [ -z "$latest" ]; then latest=unknown; detail='stable channel revision could not be verified'; fi
  [ "$current" = "$pinned" ] || detail="flake.lock disagrees with the audited manifest pin${detail:+; $detail}"
  tool_json "$name" nix-stable-channel "$current" "$pinned" "$latest" exact-flake-lock report-only "$detail"
}

check_nix_package() {
  local package=$1 command_name=$2 pinned=$3 evidence=$4 current path resolved store_name detail
  detail='latest stable is defined by the exact locked Nixpkgs revision'
  case "$evidence" in
    closure)
      closure_measure "$package" "$command_name"
      tool_json "nix:$package" nixpkgs-locked-closure "$CLOSURE_VERSION" "$pinned" "$pinned" exact-nix-derivation rebuild-only "$detail; $CLOSURE_REASON"
      return
      ;;
    user-env)
      detail="$detail; measured from the user environment command"
      ;;
    *)
      tool_json "nix:$package" nixpkgs-locked-unclassed unknown "$pinned" "$pinned" exact-nix-derivation rebuild-only \
        "$detail; the pin row carries no recognised evidence class, so no measurement source is authorised"
      return
      ;;
  esac
  current=$(installed_command_version "$command_name" || printf unknown)
  if [ "$package" = unzip ] && [ "$current" = 6.00 ]; then
    current=6.0
    detail="$detail; Info-ZIP formats its 6.0 release as 6.00"
  elif [ "$package" = unzip ] && [ "$current" = unknown ]; then
    path=$(command_path "$command_name" || true)
    resolved=$(readlink -f "$path" 2>/dev/null || true)
    store_name=${resolved#/nix/store/}; store_name=${store_name%%/*}
    case "$store_name" in
      *-unzip-*) current=${store_name#*-unzip-}; detail="$detail; derived from the exact Nix store path because Info-ZIP formats 6.0 as 6.00" ;;
    esac
  elif [ "$package" = gtkwave ] && [ "$current" = unknown ]; then
    path=$(command_path "$command_name" || true)
    resolved=$(readlink -f "$path" 2>/dev/null || true)
    store_name=${resolved#/nix/store/}; store_name=${store_name%%/*}
    case "$store_name" in
      *-gtkwave-*) current=${store_name#*-gtkwave-}; detail="$detail; derived from the exact Nix store path because the GUI version command requires a display" ;;
    esac
  fi
  tool_json "nix:$package" nixpkgs-locked-stable "$current" "$pinned" "$pinned" exact-nix-derivation rebuild-only "$detail"
}

check_ci_action() {
  local name=$1 repo=$2 recorded_tag=$3 pinned=$4 latest_tag latest detail=
  latest_tag=$(latest_github_tag_unrestricted "$repo" || true)
  if printf '%s\n' "$latest_tag" | grep -Eq '^v[0-9]+(\.[0-9]+){0,2}$'; then
    latest=$(resolve_tag_commit "$repo" "$latest_tag")
    detail="latest stable release $latest_tag; executed only by GitHub Actions"
  else
    latest=unknown
    detail='latest stable CI action release could not be verified'
  fi
  [ -n "${latest:-}" ] || latest=unknown
  tool_json "ci:$name" github-action on-demand "$pinned" "$latest" exact-action-sha ci-only "$detail (recorded $recorded_tag)"
}

resolve_tag_commit() {
  local repo=$1 tag=$2
  run_timed "$NETWORK_TIMEOUT" "$GIT_BIN" ls-remote "https://github.com/$repo.git" "refs/tags/$tag" "refs/tags/$tag^{}" 2>/dev/null | awk 'END {print $1}'
}

check_nvim_plugin() {
  local name=$1 repo=$2 policy=$3 recorded_ref=$4 manifest_pin=$5 lock_file=$6 current pinned latest latest_ref detail='' rc path
  pinned=$(jq -er --arg name "$name" '.[$name].commit | select(type == "string")' "$lock_file" 2>/dev/null || printf unknown)
  path="$NVIM_DATA_HOME/lazy/$name"
  if [ -d "$path/.git" ]; then current=$($GIT_BIN -C "$path" rev-parse HEAD 2>/dev/null || printf unknown); else current=unknown; fi
  if [ "$manifest_pin" != "$pinned" ]; then
    tool_json "nvim:$name" neovim-lazy-lock "$current" "$pinned" unknown exact-lockfile report-only 'lock file disagrees with audited plugin manifest'
    return
  fi
  if [ "$policy" = release ]; then
    latest_ref=$(latest_github_tag "$repo"); rc=$?
    if [ "$rc" -eq 0 ]; then latest=$(resolve_tag_commit "$repo" "$latest_ref"); detail="latest stable release $latest_ref"
    elif [ "$rc" -eq 2 ]; then latest=unknown; detail='latest release tag is prerelease-like'
    else latest=unknown; detail='latest stable plugin release could not be verified'
    fi
  elif [ "$policy" = head ] && [ "$recorded_ref" = HEAD ]; then
    latest=$(run_timed "$NETWORK_TIMEOUT" "$GIT_BIN" ls-remote "https://github.com/$repo.git" HEAD 2>/dev/null | awk '$2 == "HEAD" {print $1; exit}')
    detail='upstream publishes no release feed; exact default-branch commit is the documented exception'
  else
    latest=unknown; detail='unknown plugin release policy refused'
  fi
  [ -n "${latest:-}" ] || latest=unknown
  tool_json "nvim:$name" github-plugin "$current" "$pinned" "$latest" exact-lockfile report-only "$detail"
}

platform() {
  local os arch
  case "$(uname -s)" in Darwin) os=darwin ;; Linux) os=linux ;; *) os=unknown ;; esac
  case "$(uname -m)" in x86_64|amd64) arch=amd64 ;; arm64|aarch64) arch=arm64 ;; *) arch=unknown ;; esac
  printf '%s-%s\n' "$os" "$arch"
}

append_tool() {
  TOOLS=$(jq -cn --argjson tools "$TOOLS" --argjson item "$1" '$tools + [$item]')
}

collect() {
  local row name command_name package pinned integrity guarded channel repo install_policy apply_policy version policy ref commit tag
  local nvim_lock=${DEV_TOOLS_NVIM_LOCK_FILE:-$ROOT/config/nvim/lazy-lock.json}
  PLATFORM=$(platform)
  TOOLS='[]'
  for row in "${NPM_TOOL_PINS[@]}"; do
    IFS='|' read -r name command_name package pinned integrity guarded channel <<<"$row"
    append_tool "$(check_npm_tool "$name" "$command_name" "$package" "$pinned" "$integrity" "$guarded" "$channel")"
  done
  for row in "${GITHUB_TOOL_PINS[@]}"; do
    IFS='|' read -r name command_name repo pinned install_policy apply_policy <<<"$row"
    if [ "$name" = herdr ]; then append_tool "$(check_herdr)"
    else append_tool "$(check_github_tool "$name" "$command_name" "$repo" "$pinned" "$install_policy" "$apply_policy")"
    fi
  done
  append_tool "$(check_antigravity)"
  append_tool "$(check_cursor)"
  append_tool "$(check_git_repo firstmate "$FIRSTMATE_PATH" https://github.com/kunchenguid/firstmate.git "$FIRSTMATE_REV" exact-commit guarded-exact)"
  append_tool "$(check_baby_menu)"
  append_tool "$(check_nix_installer)"
  append_tool "$(check_nix_input nixpkgs-input https://github.com/NixOS/nixpkgs.git "refs/heads/nixos-${NIXPKGS_CHANNEL}" "$NIXPKGS_REV" nixpkgs)"
  append_tool "$(check_nix_input home-manager-input https://github.com/nix-community/home-manager.git "refs/heads/release-${HOME_MANAGER_CHANNEL}" "$HOME_MANAGER_REV" home-manager)"
  append_tool "$(check_npx_tool opencode-acp opencode-ai "$OPENCODE_ACP_VERSION")"
  append_tool "$(check_npx_tool omp-acp omp-acp "$OMP_ACP_VERSION")"
  append_tool "$(check_npx_tool claude-spend claude-spend "$CLAUDE_SPEND_VERSION")"
  for row in "${NIX_PACKAGE_PINS[@]}"; do
    IFS='|' read -r package command_name version evidence <<<"$row"
    append_tool "$(check_nix_package "$package" "$command_name" "$version" "$evidence")"
  done
  for row in "${CI_ACTION_PINS[@]}"; do
    IFS='|' read -r name repo tag commit <<<"$row"
    append_tool "$(check_ci_action "$name" "$repo" "$tag" "$commit")"
  done
  if [ -f "$nvim_lock" ]; then
    for row in "${NEOVIM_PLUGIN_PINS[@]}"; do
      IFS='|' read -r name repo policy ref commit <<<"$row"
      append_tool "$(check_nvim_plugin "$name" "$repo" "$policy" "$ref" "$commit" "$nvim_lock")"
    done
  fi
  RESULT=$(jq -cn --argjson checked "$NOW" --arg verified "$TOOLCHAIN_VERIFIED_AT" \
    --arg nixpkgs_channel "$NIXPKGS_CHANNEL" --arg nixpkgs_rev "$NIXPKGS_REV" \
    --arg hm_channel "$HOME_MANAGER_CHANNEL" --arg hm_rev "$HOME_MANAGER_REV" --argjson tools "$TOOLS" \
    '{schema_version:4,checked_at_epoch:$checked,pins_verified_at:$verified,tools:$tools,
      nix:{nixpkgs:{channel:$nixpkgs_channel,revision:$nixpkgs_rev},home_manager:{channel:$hm_channel,revision:$hm_rev}},
      intentionally_unmanaged:[
        {name:"GBrain lifecycle",reason:"Firstmate owns attended backup, migration, evaluation, and rollback; only its installed release is reported here."},
        {name:"WezTerm and pngpaste",reason:"Mac application and optional Homebrew clipboard helper are documented but installed outside this repository."},
        {name:"NVM and Node v20.20.2",reason:"Mac compatibility PATH points at a separately managed NVM installation."},
        {name:"Bun, Antigravity IDE, and Mavis",reason:"Mac PATH compatibility entries only; no installer is owned here."},
        {name:"Oh My Pi (omp)",reason:"Mac completion wiring uses a separately installed CLI; the repository-managed Pi command is a different distribution."},
        {name:"claude-monitor and codebase-memory-mcp",reason:"Aliases target separately managed optional tools."},
        {name:"wakeonlan, pbcopy, scp, sqlite3, xclip, xsel, and wl-copy",reason:"Operating-system or optional integration helpers, not repository-owned developer-tool installs."},
        {name:"PowerShell, macOS security, and MobaXterm",reason:"Host operating-system utilities and the documented Windows terminal are outside Home Manager and bootstrap ownership."},
        {name:"pnpm and the optional Grok CLI",reason:"Baby Menu development and quota-integration references rely on separately managed tools."},
        {name:"Nerd Font files",reason:"The Windows helper registers operator-supplied font files and does not select or download a release."}
      ],
      summary:{up_to_date:([$tools[]|select(.status=="up_to_date")]|length),drifted:([$tools[]|select(.status|contains("drifted"))]|length),pin_outdated:([$tools[]|select(.status|contains("pin_outdated"))]|length),unknown:([$tools[]|select(.status=="unknown")]|length)}}')
}

cache_valid() { [ -f "$CACHE_PATH" ] && jq -e '.schema_version == 4 and (.tools|type=="array")' "$CACHE_PATH" >/dev/null 2>&1; }
cache_fresh() {
  cache_valid || return 1
  local checked age
  checked=$(jq -r '.checked_at_epoch' "$CACHE_PATH")
  case "$checked" in ''|*[!0-9]*) return 1 ;; esac
  age=$((NOW - checked)); [ "$age" -ge 0 ] && [ "$age" -lt "$CACHE_TTL" ]
}
write_cache() {
  [ "$NO_CACHE" -eq 0 ] || return 0
  local parent tmp
  parent=${CACHE_PATH%/*}; [ "$parent" != "$CACHE_PATH" ] || parent=.
  mkdir -p "$parent" 2>/dev/null || return 0
  tmp=$(mktemp "$parent/.dev-tools-update-cache.XXXXXX") || return 0
  printf '%s\n' "$RESULT" >"$tmp" && chmod 600 "$tmp" && mv -f "$tmp" "$CACHE_PATH"
}

render_human() {
  printf '%s' "$RESULT" | jq -r '(
    .tools[] | .name + ": installed=" + .current + " pinned=" + .pinned + " latest-stable=" + .latest_stable + " [" + .status + "]" + (if .detail then " - " + .detail else "" end)
  ), "nixpkgs: " + .nix.nixpkgs.channel + " @ " + .nix.nixpkgs.revision,
     "home-manager: " + .nix.home_manager.channel + " @ " + .nix.home_manager.revision'
}

health_result() {
  local args status detail='' flag required='["--no-sandbox","--disable-dev-shm-usage","--disable-gpu"]'
  args=$($PRINTENV_BIN CHROME_DEVTOOLS_AXI_CHROME_ARGS 2>/dev/null || true)
  status=healthy
  for flag in --no-sandbox --disable-dev-shm-usage --disable-gpu; do
    printf '%s\n' "$args" | grep -Eq -- "(^|[[:space:]])${flag}([[:space:]]|$)" || { status=broken; detail="missing required flag: $flag"; break; }
  done
  jq -cn --arg status "$status" --arg detail "$detail" --argjson required "$required" \
    '{schema_version:1,checks:{chrome_devtools_headless:{status:$status,required_flags:$required} + (if $detail=="" then {} else {detail:$detail} end)}}'
}

render_health_human() {
  printf '%s' "$1" | jq -r '.checks.chrome_devtools_headless | "chrome-devtools headless flags: " + .status + (if .detail then " (" + .detail + ")" else "" end)'
}

render_startup() {
  local update_line='' health health_line=''
  if cache_fresh; then
    update_line=$(jq -r '[.tools[] | select(.status != "up_to_date") | .name + " " + .status] | if length > 0 then "dev-tools: " + join("; ") else empty end' "$CACHE_PATH")
  elif cache_valid; then
    update_line='dev-tools: the cached audit is outside its freshness window, so no tool state is claimed; run dev-tools-check-updates'
  fi
  health=$(health_result)
  if [ "$(printf '%s' "$health" | jq -r '.checks.chrome_devtools_headless.status')" != healthy ]; then
    health_line=$(printf '%s' "$health" | jq -r '.checks.chrome_devtools_headless | "dev-tools: chrome-devtools headless flags " + .status + " (" + .detail + ")"')
  fi
  [ -n "$update_line" ] && printf '%s\n' "$update_line"
  [ -n "$health_line" ] && printf '%s\n' "$health_line"
}

if ! command -v jq >/dev/null 2>&1; then printf 'dev-tools-check-updates: jq is required\n' >&2; exit 2; fi
if [ "$HEALTH" -eq 1 ]; then
  RESULT=$(health_result)
  if [ "$MODE" = json ]; then printf '%s\n' "$RESULT" | jq .; else render_health_human "$RESULT"; fi
  exit 0
fi
if [ "$STARTUP" -eq 1 ]; then render_startup; exit 0; fi
if [ "$FORCE" -eq 0 ] && [ "$NO_CACHE" -eq 0 ] && cache_fresh; then RESULT=$(cat "$CACHE_PATH")
else collect; write_cache
fi
if [ "$MODE" = json ]; then printf '%s\n' "$RESULT" | jq .; else render_human; fi
