#!/usr/bin/env bash
# Canonical lint entry point for this repository.
#
# ShellCheck over every tracked shell script, with `-x` so sourced files are
# followed and at ShellCheck's full default severity, so style-level findings
# are reported rather than filtered out. Nix evaluation is deliberately not
# duplicated here: .github/workflows/build.yml is authoritative for it and
# already runs on every pull request.
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$ROOT"

# A service environment inherits neither ~/.nix-profile/bin nor the Nix daemon
# profile. This is the same sourcing bootstrap.sh and rebuild.sh use, so there
# is one idiom for putting Nix on PATH.
if ! command -v nix >/dev/null 2>&1 &&
  [ -e /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]; then
  # shellcheck disable=SC1091
  . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
fi

command -v shellcheck >/dev/null 2>&1 || {
  echo 'dotfiles-lint: missing lint dependency: shellcheck' >&2
  exit 1
}
printf 'dotfiles-lint: %s\n' "$(shellcheck --version | sed -n 's/^version: /ShellCheck /p')"

# The shell a tracked file declares, or nothing when it declares none. It reads
# through `env`, its options and its VAR=value prefixes, and it reads the
# interpreter word rather than the whole line, so `#!/bin/bash -e` resolves to
# bash and `#!/usr/bin/env zsh` resolves to zsh (which ShellCheck cannot parse).
declared_shell() { # declared_shell <file>
  local first
  local -a words
  IFS= read -r first <"$1" 2>/dev/null || return 0
  [ "${first#\#!}" != "$first" ] || return 0
  read -r -a words <<<"${first#\#!}"
  while [ ${#words[@]} -gt 0 ]; do
    case ${words[0]} in
      */env | env | -* | *=*) words=("${words[@]:1}") ;;
      *)
        printf '%s\n' "${words[0]##*/}"
        return 0
        ;;
    esac
  done
}

# Every tracked *.sh, because a sourced library is a shell file even with no
# shebang and ShellCheck defaults such a file to sh, plus every tracked file
# whose shebang names a shell, which is what covers extensionless scripts like
# system/ct110-network-failover/vpn-ethernet-failover. Anything else is not a
# shell script, and is listed rather than dropped silently.
files=()
skipped=()
while IFS= read -r candidate; do
  [ -f "$candidate" ] || continue
  case $candidate in
    *.sh)
      files+=("$candidate")
      continue
      ;;
  esac
  shell=$(declared_shell "$candidate")
  case $shell in
    sh | bash | dash | ksh) files+=("$candidate") ;;
    '') ;;
    *) skipped+=("$candidate (#!$shell)") ;;
  esac
done < <(git ls-files)

[ ${#files[@]} -gt 0 ] || { echo 'dotfiles-lint: no shell files found' >&2; exit 1; }
printf 'dotfiles-lint: checking %d shell file(s)\n' "${#files[@]}"
if [ ${#skipped[@]} -gt 0 ]; then
  printf 'dotfiles-lint: not a shell script, skipped %d file(s):\n' "${#skipped[@]}"
  printf '  %s\n' "${skipped[@]}"
fi

if shellcheck -x -- "${files[@]}"; then
  printf 'dotfiles-lint: no findings\n'
else
  status=$?
  printf 'dotfiles-lint: ShellCheck reported findings (exit %d)\n' "$status" >&2
  exit "$status"
fi
